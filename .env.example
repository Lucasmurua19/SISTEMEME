# Copiá este archivo a .env y completá lo que corresponda. No lo subas a ningún repositorio.
# Las claves de proveedor viven solo en el servidor: nunca llegan al navegador ni a los logs.

# --- Base de datos (Compose arma DATABASE_URL con estos valores)
POSTGRES_USER=radar
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=radar

# --- Modo de datos: "fixtures" reproduce escenarios sintéticos; "live" usa RPC de Solana y Jupiter
DATA_MODE=fixtures

# --- Solo DATA_MODE=live
# URL RPC (puede incluir una clave del proveedor) y su WebSocket. Usá un nodo/proveedor con límites razonables.
SOLANA_RPC_URL=https://TU-PROVEEDOR-RPC/TU-CLAVE
SOLANA_WS_URL=wss://TU-PROVEEDOR-RPC/TU-CLAVE
# Jupiter Swap API v2 (solo lectura). Sin clave funciona a ~0,5 req/s; con clave, el límite de tu plan.
JUPITER_API_KEY=
COMMITMENT=confirmed
# Cuenta que participa en cada migración de Pump.fun (withdraw_authority). Verificala con la documentación vigente.
# PUMP_MIGRATION_ACCOUNT=39azUYFWPz3VHgKCf3VChUwbpURdCHRxjWVowf5jUJjg

# --- Estrategia (opcional): archivo JSON con una versión nueva. Por defecto, config/strategy-fixtures-v1.json en fixtures
# STRATEGY_CONFIG_PATH=config/mi-estrategia-v2.json

# --- Panel y API
# URL interna de la API para Next.js (red de Compose). El navegador solo ve /api/v1/* del panel.
API_INTERNAL_URL=http://api:8000
POLL_SECONDS=5
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300
# Controles de pausa de la simulación: se habilitan solo con PANEL_CONTROLS=true Y un ADMIN_TOKEN no vacío.
# Si publicás el panel fuera de tu máquina, agregá autenticación delante (proxy inverso con login).
ADMIN_TOKEN=
PANEL_CONTROLS=false

# --- Puertos publicados (solo en 127.0.0.1)
WEB_PORT=3000
API_PORT=8000
# La base no se publica por defecto. Solo se usa con: docker compose -f compose.yaml -f compose.db-port.yaml up
# (si tenés un PostgreSQL instalado en Windows, el 5432 ya está ocupado: usá otro puerto)
DB_PORT=55432

# --- Ritmo del worker
TICK_SECONDS=2
FIXTURE_STEP_SECONDS=15
LOG_LEVEL=INFO
